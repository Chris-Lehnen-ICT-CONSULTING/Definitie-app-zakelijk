%%{ init: { 'theme': 'base', 'themeVariables': { 'primaryColor': '#4A90E2', 'fontSize': '13px' } } }%%
flowchart TD
    classDef foundation fill:#1a237e,stroke:#0d1642,color:#ffffff,stroke-width:2px
    classDef ufoExt fill:#283593,stroke:#1a237e,color:#ffffff,stroke-width:2px
    classDef bridge fill:#4527a0,stroke:#311b92,color:#ffffff,stroke-width:2px
    classDef perspective fill:#00695c,stroke:#004d40,color:#ffffff,stroke-width:2px
    classDef application fill:#e65100,stroke:#bf360c,color:#ffffff,stroke-width:2px
    classDef valorCore fill:#b71c1c,stroke:#7f0000,color:#ffffff,stroke-width:2px
    classDef tessera fill:#f9a825,stroke:#f57f17,color:#1a1a1a,stroke-width:2px

    %% ═══════════════════════════════════════
    %% LAYER 0 — Foundational Ontology
    %% ═══════════════════════════════════════
    subgraph L0["Layer 0 — Foundational Ontology"]
        gufo["gUFO Core\n─────────\nEntity, Event, Relator,\nQuality, Kind, Role, Phase"]:::foundation
    end

    %% ═══════════════════════════════════════
    %% LAYER 1 — UFO Extensions
    %% ═══════════════════════════════════════
    subgraph L1["Layer 1 — UFO Domain Extensions"]
        ufob["UFO-B\n─────────\nEvents, Dispositions,\nCausal Relations"]:::ufoExt
        ufoc["UFO-C\n─────────\nAgents, Commitments,\nSocial Relations"]:::ufoExt
        ufol["UFO-L\n─────────\nRights, Duties,\nNorms, Policies"]:::ufoExt
    end

    %% ═══════════════════════════════════════
    %% LAYER 2 — Ontological Extensions
    %% ═══════════════════════════════════════
    subgraph L2["Layer 2 — Ontological Extensions"]
        coodm["COoDM\n─────────\nDecisions, Preferences,\nDeliberation"]:::bridge
        cover["COVER\n─────────\nValue, Risk,\nValue Experience"]:::bridge
        acta["ACTA\n─────────\nTransactions,\nDEMO Grounding"]:::bridge
    end

    %% ═══════════════════════════════════════
    %% TESSERA — Epistemic Anchor
    %% ═══════════════════════════════════════
    subgraph TESS["Cross-Perspectival Epistemic Layer"]
        tessera["Tessera\n─────────\nElk model-element = claim\nProposed → Contested →\nAccepted / Rejected"]:::tessera
    end

    %% ═══════════════════════════════════════
    %% LAYER 3 — Perspective Modules
    %% ═══════════════════════════════════════
    subgraph L3["Layer 3 — 7 Perspective Modules"]
        causa["Causa\n─────────\nCausale mechanismen\nen feedback loops"]:::perspective
        socia["Socia\n─────────\nStakeholders,\ndoelen, macht"]:::perspective
        lexa["Lexa\n─────────\nNormen, rechten,\nplichten"]:::perspective
        acta2["Acta\n─────────\nService transacties,\nworkflows"]:::perspective
        axia["Axia\n─────────\nWaarden, spanningen,\nimplicaties"]:::perspective
        delibera["Delibera\n─────────\nDemocratische\nbesluitvorming"]:::perspective
        forma["Forma\n─────────\nOntologische structuur,\nOntoUML 2.0"]:::perspective
    end

    %% ═══════════════════════════════════════
    %% LAYER 4 — Application + Integration
    %% ═══════════════════════════════════════
    subgraph L4["Layer 4 — Application Ontology"]
        app["Application\n─────────\nDesignSpace, Phase,\nAlternative, Participant"]:::application
        capax["Capax\n─────────\nCapabilities,\nPermissions"]:::application
        nexus["Nexus\n─────────\nCross-module\nRelations"]:::application
        sysont["SysOnt\n─────────\nSystem Configuration"]:::application
    end

    subgraph VC["VALOR Core"]
        valorCore["valor-core\n─────────\nUnified Graph,\nSPARQL Endpoint"]:::valorCore
        demos["Demos\n─────────\nDemo Scenarios,\nExamples"]:::valorCore
    end

    %% ═══════════════════════════════════════
    %% CONNECTIONS — Foundation upward
    %% ═══════════════════════════════════════
    gufo -->|"extends with events"| ufob
    gufo -->|"extends with social"| ufoc
    gufo -->|"extends with legal"| ufol

    ufob -->|"causal grounding"| coodm
    ufoc -->|"agent grounding"| coodm
    ufoc -->|"social grounding"| cover
    ufol -->|"legal authority"| acta

    %% Layer 2 → Tessera
    coodm -->|"beliefs as claims"| tessera
    cover -->|"value as claims"| tessera
    acta -->|"transactions as claims"| tessera

    %% Tessera → All Perspectives
    tessera -->|"causal claims"| causa
    tessera -->|"stakeholder claims"| socia
    tessera -->|"legal claims"| lexa
    tessera -->|"transaction claims"| acta2
    tessera -->|"value claims"| axia
    tessera -->|"process claims"| delibera
    tessera -->|"engineering claims"| forma

    %% Perspective grounding in Layer 1-2
    ufob -.->|"event theory"| causa
    ufoc -.->|"agent theory"| socia
    ufol -.->|"Hohfeld framework"| lexa
    acta -.->|"DEMO pattern"| acta2
    cover -.->|"value theory"| axia
    coodm -.->|"COoDM + IBIS"| delibera
    gufo -.->|"gUFO conformance"| forma

    %% Application layer connections
    causa --> app
    socia --> app
    lexa --> app
    acta2 --> app
    axia --> app
    delibera --> app
    forma --> app

    app --> capax
    app --> nexus
    app --> sysont

    %% VALOR Core integrates everything
    capax --> valorCore
    nexus --> valorCore
    sysont --> valorCore
    demos -.->|"example data"| valorCore
