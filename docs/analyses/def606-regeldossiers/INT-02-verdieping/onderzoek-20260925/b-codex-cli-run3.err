+assert anchor in c
+c=c.replace(anchor,anchor+'\n\n(v3: RA-B-13) Voor **alle G-kolommen** geldt: alleen één definitiekern in de generatie-uitvoer, geen vraag/toelichting/bronverantwoording/statusregel. Een noodzakelijke vraag loopt via T/reviewerhulp; appstatus toont voorlopigheid buiten de kern. Afzonderlijke bron- of procesinformatie is invoer/appbeheer of een afzonderlijk gevraagde taak, geen tweede G-uitvoerblok. Zonder gedragen kern geen gefingeerd succes; de latere appafhandeling moet dit aantonen. H is afzonderlijk en nog niet actief.')
+c=c.replace('Begrip afbakenen, behandelinstructie apart; bij ontbrekende kernbron geen vervangend kenmerk verzinnen.', '(v3: RA-B-13) Alleen begripskern; behandelregel niet in uitvoer. Bij ontbrekende kernbron geen kenmerk verzinnen; verduidelijking via T/app.')
+c=c.replace('Afleidingscriteria behouden; geen discretionair oordeel invoegen; bronadministratie apart.', '(v3: RA-B-13) Alleen kern met afleidingscriteria; geen discretionair oordeel. Bronadministratie blijft buiten deze modeluitvoer.')
+c=c.replace('Deze handelingsrichtlijn niet als definiens opleveren; vraag bron voor het beoogde begrip.', '(v3: RA-B-13) Handelingsrichtlijn niet als definiens; geen vervangende kern verzinnen. Benodigde bronvraag via T/app, niet in de generatiezin.')
+c=c.replace('Geen stille synthese of kunstmatig compromis; afzonderlijke vraag naar toepasselijke bron/betekenis.', '(v3: RA-B-13) Geen stille keuze of kunstmatig compromis in een kern. Vraag naar toepasselijke bron/betekenis via T/app; geen vraag als G-uitvoer.')
+c=c.replace('Eerste segment als kern, tweede hoogstens afzonderlijke toelichting met bron; geen nieuw kenmerk toevoegen.', '(v3: RA-B-13) Alleen het zelfstandig gedragen eerste segment als kern; geen tweede procesblok in G-uitvoer. Een toelichtingsvoorstel vraagt een afzonderlijke taak/kanaal; geen nieuw kenmerk.')
+c=c.replace('Historischzelfde criterium zonder voorwaardewoord;', 'Historisch criterium zonder voorwaardewoord;')
+c += '\n(v3: RA-B-07) (v3: RA-B-24) Ontvangen A-P3 is aanvullend **servicebewijs** bij C04/C05 met context: C04 INT-01/INT-10-fail met patroonsuggestie, C05 beide pass; INT-02 beide J. Geen nieuwe INT-02-normverwachting en geen bewijs dat de teksten equivalent zijn. INT-10 is door Chris geparkeerd voor een eigen dossier; geen herstelgrond, besluitpunt of wijzigingsvoorwaarde voor INT-02. G/T/H-referenties blijven per regel beoordeeld.\n'
+
+for name in ('onderzoek-b-v3.md','casusregister-b-v3.md'):
+    assert not (root/name).exists(), name
+with (root/'onderzoek-b-v3.md').open('x') as f: f.write(t)
+with (root/'casusregister-b-v3.md').open('x') as f: f.write(c)
+print('Nieuwe v3-documenten geschreven; v2 uitsluitend gelezen.')

