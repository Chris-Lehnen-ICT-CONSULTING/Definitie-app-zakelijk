exec
/bin/zsh -lc "python3 - <<'PY'
from pathlib import Path
import difflib
for a,b in [('onderzoek-b-v2.md','onderzoek-b-v3.md'),('casusregister-b-v2.md','casusregister-b-v3.md')]:
 d=list(difflib.unified_diff(Path(a).read_text().splitlines(),Path(b).read_text().splitlines(),fromfile=a,tofile=b,n=1))
 print(a,'->',b,'gewijzigde regels',sum(x.startswith(('+','-')) and not x.startswith(('+++','---')) for x in d))
 if a.startswith('casusregister'): print('\\n'.join(d))
