/bin/zsh -lc "python3 - <<'PY'
import pathlib,json,hashlib,re,datetime
root=pathlib.Path('.').resolve()
baseline=json.loads(\"{\\\"bestaande_bestanden\\\":{\\\"bewijs/bronnen-en-toegang-v1.json\\\":\\\"51ab5073117b070c1bf22970060c9162ee411ff854457eb4a4e3a41ce9df0bb0\\\",\\\"bewijs/exitstatus-v1.txt\\\":\\\"9a271f2a916b0b6ee6cecb2426f0b3206ef074578be55d9bc94f6f3fe3ab86aa\\\",\\\"bewijs/historisch-hergebruik-v1.json\\\":\\\"44d5423380d6bde2f5700efeaab8faf592d1c2be83290fea36c33bdfdff2a6d5\\\",\\\"bewijs/historische-diff-v1.txt\\\":\\\"54d86140f3dc3941fb0e542ab9a10660c38be56686ba3b776b54161db6677fd8\\\",\\\"bewijs/proefopzet-v1.json\\\":\\\"ec6b1ff8179ed554ed4d034020b3541e2126a7e0bc41cc9b6b496aed0d50b553\\\",\\\"bewijs/proefuitkomsten-v1.json\\\":\\\"cc3d65b7b79868ef5f7201d32607294c36a6b9f6a007e2b5811a54744a74a392\\\",\\\"bewijs/proefuitvoer-v1.log\\\":\\\"239993a0819c3bedb335d906f9cc0158fd142de733be036b3999d64d5850c784\\\",\\\"bewijs/proeven-c-v1.py\\\":\\\"2d5cbc220d625df20dab6f4b66425439246a85a7380716353523c93fefe7d930\\\",\\\"bewijs/uitvoering-en-grenzen-v1.md\\\":\\\"915122c5264638242dabcc487fab0c5acf34f253f98bb38a28cd5452a74c28bc\\\",\\\"casusregister-c-v1.md\\\":\\\"72325dcc5558c3c129b4b145284a8d4d41eacbeef26fdeb97efa39278f6b8b12\\\",\\\"manifest-c-v1.json\\\":\\\"68373998d64db6ec7a0087783f588db059c42a47185e6830dec1e2bd5422bf4f\\\",\\\"onderzoek-c-v1.md\\\":\\\"896d589b1db8289f68c46c43e634fa87c8099980e87723665c2a8b3de0c856e2\\\"},\\\"bronhashes\\\":{\\\"../gedeeld/gezamenlijke-synthese-v3.md\\\":\\\"544c3993d32c7986922adfbf9823bd2666e611566dad466c4fe329f62197746c\\\",\\\"../gedeeld/besluitnotitie-chris-v3.md\\\":\\\"27b515eef361cb5c8ad9256c95dd60f47786491c86967e8bb0981c4dcb294b89\\\",\\\"../gedeeld/gezamenlijk-casusregister-v3.md\\\":\\\"c878fe01c1d4b053c06eacd8919eb309bbad2ab9341d45531448ff6f75c897a1\\\",\\\"../a-cowork/review-a-op-c-v1.md\\\":\\\"2a0a9a70f6f64ec0502d939884dae082b287ae088b04a2d2b20b5b5c30c1f555\\\",\\\"../a-cowork/normlezing-coordinator-v1.md\\\":\\\"d48f0e2ce350b9b74e583f039f824f7a4c7bd3a5e452a615e0955e95d5c3a586\\\",\\\"../a-claude-cli/onderzoek-a-v2.md\\\":\\\"641c296e182ee6e0f0d6323239dea432d2e481abdf455f13e8a4a72df303287c\\\",\\\"../b-codex-cli/onderzoek-b-v3.md\\\":\\\"ac94555b069366510e560a0e63b681bca60b399e1ff47d0546e7652adbec85ec\\\",\\\"../b-codex-cli/synthesecontrole-b-v2.md\\\":\\\"e222aaad8267f229178946c71d3a2214b60f10b384498c10013b53a09e7edd49\\\",\\\"../gedeeld/feitenbasis-v1.md\\\":\\\"fa895f1d6f9777e44837d8cc936688827aedacee22d9ba858d9fc9d7fd89f530\\\",\\\"../gedeeld/bronnen/astra-Afleidingsregel-raw.wikitext\\\":\\\"793375d9d503ce5303b460b87a6372c9ff6ac3c10d8e40219b70673415b79f4d\\\",\\\"../gedeeld/bronnen/astra-Beslisregel-raw.wikitext\\\":\\\"35477c067cb6baaa114b17112fd6e79e35e12e349619783f52d3d66525e2ca8e\\\",\\\"../gedeeld/bronnen/astra-INT-02-raw.wikitext\\\":\\\"01d00ea0fb674329f0eb3bf6f470b587f9b871e8d40d891ed1142b876abedc1b\\\"},\\\"v1_hashafwijkingen\\\":[],\\\"nieuwe_doelen_bestaan\\\":{\\\"synthesecontrole-c-v1.md\\\":false,\\\"manifest-c-v2.json\\\":false}}\")
def digest(p): return hashlib.sha256(p.read_bytes()).hexdigest()
old_drift=[p for p,h in baseline['bestaande_bestanden'].items() if digest(root/p)"'!=h]
source_drift=[p for p,h in baseline['"'bronhashes'].items() if digest(root/p)"'!=h]
assert not old_drift,old_drift
assert not source_drift,source_drift
report=root/'"'synthesecontrole-c-v1.md'
s=report.read_text()
ids=re.findall(r'"'^'"\\*\\*(SC-C-\\d+) →',s,re.M)
assert ids==[f'SC-C-{n:02d}' for n in range(1,15)],ids
register=(root/'../gedeeld/gezamenlijk-casusregister-v3.md').read_text()
case_ids=re.findall(r'"'^'"\\| (C\\d+) \\|',register,re.M)
assert len(case_ids)==len(set(case_ids))==76
assert all(f'C{n}' in case_ids for n in range(100,119))
links=re.findall(r'\\]\\((["'^)]+)'"\\)',s)
missing=[x for x in links if x"'!='"'manifest-c-v2.json' and not (root/x).exists()]
assert not missing,missing
p=json.loads((root/'bewijs/proefuitkomsten-v1.json').read_text())
assert len(p['proeven'])==6 and all(x['uitgevoerd'] for x in p['proeven'])
assert p['opzet_sha256']==digest(root/'bewijs/proefopzet-v1.json')
assert (root/'bewijs/exitstatus-v1.txt').read_text().strip()=='0'
files=[]
for f in sorted(root.rglob('*')):
    if f.is_file() and '.git' not in f.parts:
        files.append({'pad':str(f.relative_to(root)),'bytes':f.stat().st_size,'sha256':digest(f)})
