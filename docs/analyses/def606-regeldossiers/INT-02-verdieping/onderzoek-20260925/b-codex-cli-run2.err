     6	"""
     7	
     8	import asyncio
     9	import json
    10	import subprocess
    11	import sys
    12	from pathlib import Path
    13	
    14	from services.validation.modular_validation_service import ModularValidationService
    15	from toetsregels.manager import get_toetsregel_manager
    16	
    17	HIER = Path(__file__).resolve().parent
    18	BUREN = ["INT-01", "INT-10", "ARAI-04", "ARAI-04SUB1", "STR-06", "INT-08", "ESS-04", "ESS-05"]
    19	CTX = {
    20	    "organisatorische_context": ["Dienst Justis"],
    21	    "juridische_context": ["bestuursrecht"],
    22	    "wettelijke_basis": ["Algemene wet bestuursrecht"],
    23	}
    24	
    25	CASUSSEN = [
    26	    ("INT02-C01", "transitie-eis", "transitie-eis: eis die een organisatie ondersteunt om migratie van de huidige naar de toekomstige situatie mogelijk te maken.", {}),
    27	    ("INT02-C02", "transitie-eis", "transitie-eis: eis die een organisatie moet ondersteunen om migratie van de huidige naar de toekomstige situatie mogelijk te maken.", {}),
    28	    ("INT02-C03", "aanvraag", "Aanvraag die wordt afgewezen indien een bijlage ontbreekt.", {}),
    29	    ("INT02-C04", "even getal", "Getal dat even is indien het zonder rest door twee deelbaar is.", {}),
    30	    ("INT02-C05", "even getal", "Geheel getal dat zonder rest door twee deelbaar is.", {}),
    31	    ("INT02-C06", "leeg", "", {}),
    32	    ("INT02-C10", "stelselmatige dader", "persoon die in de vijf jaar voorafgaand aan het laatste feit drie maal wegens een misdrijf onherroepelijk is veroordeeld.", {}),
    33	    ("INT02-C11", "stelselmatige dader", "persoon die als stelselmatige dader geldt indien hij in de vijf jaar voorafgaand aan het laatste feit drie maal wegens een misdrijf onherroepelijk is veroordeeld.", {}),
    34	    ("INT02-C12", "weigering", "besluit waarmee de bevoegde autoriteit een aanvraag afwijst, tenzij zij van oordeel is dat de aanvrager daardoor onevenredig zou worden benadeeld.", {}),
    35	    ("INT02-C13", "vervallenverklaring", "besluit waarmee de bevoegde autoriteit een vergunning intrekt wanneer zij dat na afweging van de belangen van de houder evenredig acht.", {}),
    36	    ("INT02-C14", "aangifte", "verklaring die een getuige van een strafbaar feit moet afleggen bij de politie.", {}),
    37	    ("INT02-C15", "aanvraag", "verzoek dat de behandelaar binnen zes weken beoordeelt en bij een ontbrekende bijlage afwijst.", {}),
    38	    ("INT02-C16", "verzuimboete", "bestuurlijke boete die wordt opgelegd wanneer een aangifte niet tijdig is gedaan.", {}),
    39	    ("INT02-C17", "stemgerechtigd lid", "Een lid is stemgerechtigd indien ingeschreven vóór 1 januari.", {}),
    40	    ("INT02-C18", "stemgerechtigd lid", "lid dat vóór 1 januari van het lopende verenigingsjaar is ingeschreven.", {}),
    41	    ("INT02-C19", "gewaarmerkt document", "Een document geldt als gewaarmerkt mits voorzien van handtekening en datum.", {}),
    42	    ("INT02-C20", "eigen risico", "deel van de zorgkosten dat een verzekerde zelf draagt voor zover die kosten onder de basisverzekering vallen.", {}),
    43	    ("INT02-C21", "tenzij-clausule", "contractbepaling die een uitzondering op een hoofdregel formuleert.", {}),
    44	    ("INT02-C22", "tijdige aangifte", "aangifte die binnen vijf werkdagen na het feit is gedaan.", {}),
    45	    ("INT02-C23", "toegang", "Toegang:", {}),
    46	    ("INT02-C24", "toegang", "Toegang: toestemming verleend door een bevoegde autoriteit, indien alle voorwaarden zijn vervuld.", {}),
    47	    ("INT02-C25", "korting", "korting: verlaging indien tijdig betaald", {}),
    48	    ("INT02-C26", "identificatieplichtige", "Een persoon met een paspoort of, indien niet beschikbaar, een identiteitskaart", {}),
    49	    ("INT02-C27", "leeftijd", "aantal volledige jaren tussen de geboortedatum van een persoon en de peildatum.", {}),
    50	    ("INT02-C29", "aanvraag", "Aanvraag die wordt afgewezen indien een bijlage ontbreekt.", CTX),
    51	]
    52	
    53	
    54	async def draai():
    55	    svc = ModularValidationService(get_toetsregel_manager(), None, None)
    56	    uit = []
    57	    for cid, begrip, tekst, ctx in CASUSSEN:
    58	        res = await svc.validate_definition(
    59	            begrip=begrip, text=tekst, ontologische_categorie=None, context=dict(ctx)
    60	        )
    61	        review = {r.get("rule_id"): r for r in res.get("review_required") or []}
    62	        statussen = res.get("rule_statuses") or {}
    63	        viol = sorted({str(v.get("code") or v.get("rule_id")) for v in res.get("violations") or []})
    64	        r02 = review.get("INT-02") or {}
    65	        uit.append(
    66	            {
    67	                "id": cid,
    68	                "begrip": begrip,
    69	                "tekst": tekst,
    70	                "context": ctx,
    71	                "int02_status": statussen.get("INT-02"),
    72	                "int02_in_review_required": "INT-02" in review,
    73	                "int02_in_passed": "INT-02" in (res.get("passed_rules") or []),
    74	                "int02_violation": "INT-02" in viol,
    75	                "int02_reason": r02.get("reason"),
    76	                "int02_signals": list(r02.get("signals") or []),
    77	                "buur_statussen": {c: statussen.get(c) for c in BUREN},
    78	                "violations": viol,
    79	                "overall_score": res.get("overall_score"),
    80	                "is_acceptable": res.get("is_acceptable"),
    81	            }
    82	        )
    83	    return uit
    84	
    85	
    86	def main():
    87	    commit = subprocess.run(["git", "rev-parse", "HEAD"], capture_output=True, text=True).stdout.strip()
    88	    (HIER / "p1-invoer.json").write_text(
    89	        json.dumps([{"id": c, "begrip": b, "tekst": t, "context": x} for c, b, t, x in CASUSSEN], ensure_ascii=False, indent=2),
    90	        encoding="utf-8",
    91	    )
    92	    uitkomsten = asyncio.run(draai())
    93	    (HIER / "p1-uitkomsten.json").write_text(
    94	        json.dumps({"commit": commit, "python": sys.version, "uitkomsten": uitkomsten}, ensure_ascii=False, indent=2),
    95	        encoding="utf-8",
    96	    )
    97	    for u in uitkomsten:
    98	        print(u["id"], u["int02_status"], u["int02_signals"], "viol=", u["violations"])
    99	
   100	
   101	if __name__ == "__main__":
   102	    main()
     1	"""Proef P2 (onderzoekslijn A, INT-02): werkelijke rendering in de generatieprompt.
     2	
     3	Offline; bouwt de geregistreerde promptmodules met de standaardconfig van
     4	ModularPromptAdapter en legt de relevante regels vast. Geen modelcalls.
     5	Uitvoeren vanuit de repo-root:
     6	    PYTHONPATH=src .venv/bin/python <dit bestand>
     7	"""
     8	
     9	import json
    10	import re
    11	import subprocess
    12	from pathlib import Path
    13	from types import SimpleNamespace
    14	
    15	from services.prompts.modular_prompt_adapter import ModularPromptAdapter
    16	from services.prompts.modules.integrity_rules_module import IntegrityRulesModule
    17	
    18	HIER = Path(__file__).resolve().parent
    19	MODULES = ["integrity_rules", "structure_rules", "ess_rules", "arai_rules"]
    20	ZOEK = re.compile(r"indien|mits|tenzij|alleen als|voorwaard|beslisregel|INT-02|ARAI-04|INT-01 |STR-09", re.IGNORECASE)
    21	
    22	
    23	def main():
    24	    commit = subprocess.run(["git", "rev-parse", "HEAD"], capture_output=True, text=True).stdout.strip()
    25	    adapter = ModularPromptAdapter()
    26	    orch = adapter._orchestrator
    27	    geregistreerd = {mid: type(m).__name__ for mid, m in orch.modules.items()}
    28	    ctx = SimpleNamespace(enriched_context=None)
    29	    uitvoer = {}
    30	    for mid in MODULES:
    31	        out = orch.modules[mid].execute(ctx)
    32	        uitvoer[mid] = {
    33	            "success": out.success,
    34	            "metadata": out.metadata,
    35	            "relevante_regels": [r for r in out.content.splitlines() if ZOEK.search(r)],
    36	        }
    37	    int_content = orch.modules["integrity_rules"].execute(ctx).content
    38	    blok = []
    39	    actief = False
    40	    for r in int_content.splitlines():
    41	        if r.startswith("🔹 **INT-02"):
    42	            actief = True
    43	        elif r.startswith("🔹") and actief:
    44	            break
    45	        if actief:
    46	            blok.append(r)
    47	    alle = "\n".join(orch.modules[m].execute(ctx).content for m in orch.modules if hasattr(orch.modules[m], "execute") and m in MODULES)
    48	    resultaat = {
    49	        "commit": commit,
    50	        "include_examples_in_rules": adapter.component_config.include_examples_in_rules,
    51	        "geregistreerde_modules": geregistreerd,
    52	        "integrity_rules_module_geregistreerd": any(isinstance(m, IntegrityRulesModule) for m in orch.modules.values()),
    53	        "dode_toegang_voorbeeld_in_uitvoer": "toestemming verleend door een bevoegde autoriteit" in alle,
    54	        "int02_blok_letterlijk": blok,
    55	        "modules": uitvoer,
    56	    }
    57	    (HIER / "p2-uitkomsten.json").write_text(json.dumps(resultaat, ensure_ascii=False, indent=2), encoding="utf-8")
    58	    print(json.dumps({k: resultaat[k] for k in ("include_examples_in_rules", "integrity_rules_module_geregistreerd", "dode_toegang_voorbeeld_in_uitvoer", "int02_blok_letterlijk")}, ensure_ascii=False, indent=2))
    59	
    60	
    61	if __name__ == "__main__":
    62	    main()

