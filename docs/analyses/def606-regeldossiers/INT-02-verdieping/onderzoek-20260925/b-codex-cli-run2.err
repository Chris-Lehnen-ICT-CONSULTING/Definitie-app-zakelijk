assert all(x['sha256_unchanged'] for x in prior)
t=Path('review-b-op-a-v1.md').read_text(); ids=re.findall(r'"'^### (RB-A-'"\\d+)',t,re.M)
assert ids==[f'RB-A-{i:02d}' for i in range(1,27)]
assert t.count('**Bron/tegenbewijs:**')==26 and t.count('**Gevolg/correctie:**')==26
for title in ['Materiële punten','Niet-materiële preciseringen','Keuzes voor Chris']: assert title in t
for i in range(1,10):assert f'B-{i}' in t
for block in t.split('\\n\\n'):
 rows=[l for l in block.splitlines() if l.startswith('|')]
 if rows: assert len(set(l.count('|') for l in rows))==1
bind=json.loads(Path('bewijs/review-bronbinding-v1.json').read_text())
sources=[{'path':x['path'],'unchanged':hashlib.sha256(Path(x['path']).read_bytes()).hexdigest()==x['sha256']} for x in bind['source_files']]
assert all(x['unchanged'] for x in sources)
v={'tijd_utc':datetime.now(timezone.utc).isoformat(),'bewijssoort':'oplevercontrole documenten en hashes, geen appproef','oude_manifestbestanden':prior,'reviewbronbestanden':sources,'reviewpunten':len(ids),'bron_en_correctie_per_punt':True,'tabellen_consistent':True,'besluiten_B1_B9_aanwezig':True,'erratum':'review-b-op-a-v1-erratum.md: RB-A-13 juiste codevindplaats 1920–1921','python_artefactaudit':sys.version,'geen_nieuwe_app_model_of_ui_proef':True}
with Path('bewijs/review-oplevercontrole-v1.json').open('x') as f:json.dump(v,f,ensure_ascii=False,indent=2)
files=[]
for p in sorted(root.rglob('*')):
