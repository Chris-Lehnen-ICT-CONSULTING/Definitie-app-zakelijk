/bin/zsh -lc "sed -n '35,39p' ../gedeeld/besluitnotitie-chris-v2.md; python3 - <<'PY'
from pathlib import Path
import json,hashlib
p=Path('../a-cowork/bewijs')
a=json.loads((p/'proef-c1-uitkomsten-run1.json').read_text());b=json.loads((p/'proef-c1-uitkomsten.json').read_text());e=json.loads((p/'proef-c1-uitvoering-run2.json').read_text())
