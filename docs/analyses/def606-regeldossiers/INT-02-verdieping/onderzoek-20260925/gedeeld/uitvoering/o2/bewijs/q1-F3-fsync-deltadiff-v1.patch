+        monkeypatch.setattr(os, "fsync", fsync)
+    elif moment == "fsync-blokkade":
+        fsync, geinjecteerd = _fsync_faalt_op(blokkade)
+        monkeypatch.setattr(os, "fsync", fsync)
+    else:
