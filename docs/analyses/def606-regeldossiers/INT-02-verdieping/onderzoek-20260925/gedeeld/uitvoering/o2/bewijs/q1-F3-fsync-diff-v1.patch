+class _Klok:
+    """Gesimuleerde monotone klok: tijd verstrijkt alleen per inferentie."""
+
+    def __init__(self) -> None:
+        self.nu = 0.0
+
+    def monotonic(self) -> float:
+        return self.nu
+
