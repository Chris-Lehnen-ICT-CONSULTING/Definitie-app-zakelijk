+
+def _zonder(veld):
+    def wijzig(data):
+        del data[veld]
+
+    return wijzig
+
+
+def _topveld(veld, waarde):
+    def wijzig(data):
+        data[veld] = waarde
+
+    return wijzig
+
+
+def _dubbel(data):
+    data["gevallen"].append(dict(data["gevallen"][5]))
