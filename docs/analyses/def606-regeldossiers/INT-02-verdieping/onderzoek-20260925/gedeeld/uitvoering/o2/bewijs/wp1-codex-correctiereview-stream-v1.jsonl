itaat(ref in teksten)\n   501\t        tekst = teksten[ref]\n   502\t    else:\n   503\t        waarden = getattr(invoer, veld)\n   504\t        _citaat(0 <= ref < len(waarden))\n   505\t        tekst = waarden[ref]\n   506\t    _citaat(_gevuld(tekst))\n   507\t    return tekst\n   508\t\n   509\t\n   510\tdef _controleer_citaten(uitvoer: dict[str, Any], invoer: Int02Invoer) -> None:\n   511\t    \"\"\"Elk citaat staat exact op zijn posities; elke grond is herleidbaar.\"\"\"\n   512\t    for passage in uitvoer[\"passages\"]:\n   513\t        _citaat(\n   514\t            _staat_op(invoer.kern, passage[\"quote\"], passage[\"start\"], passage[\"end\"])\n   515\t        )\n   516\t        grond = passage[\"ground\"]\n   517\t        tekst = _grondbron(grond, invoer)\n   518\t        if grond[\"quote\"] is not None:\n   519\t            _citaat(_staat_op(tekst, grond[\"quote\"], grond[\"start\"], grond[\"end\"]))\n   520\t\n   521\t\n   522\tdef _een_vraag(vraag: Any) -> bool:\n   523\t    \"\"\"Mechanisch: één niet-lege tekst die eindigt op het enige vraagteken.\"\"\"\n   524\t    return (\n   525\t        isinstance(vraag, str)\n   526\t        and vraag.count(\"?\") == 1\n   527\t        and vraag.rstrip().endswith(\"?\")\n   528\t        and bool(vraag.rstrip(\"? \\t\\n\"))\n   529\t    )\n   530\t\n   531\t\n   532\tdef _controleer_samenhang(uitvoer: dict[str, Any]) -> None:\n   533\t    \"\"\"Verdict, passages, vraag, onzekerheid, reikwijdte en dekking passen samen.\"\"\"\n   534\t    verdict = uitvoer[\"verdict\"]\n   535\t    functies = {p[\"function\"] for p in uitvoer[\"passages\"]}\n   536\t    vraag, scope = uitvoer[\"question\"], uitvoer[\"scope_reason\"]\n   537\t    if verdict != \"not_applicable\":\n   538\t        _vorm(scope is None)\n   539\t    if verdict == \"pass\":\n   540\t        _vorm(bool(functies) and functies <= BESCHRIJVEND)\n   541\t        _vorm(uitvoer[\"coverage\"] == \"complete\")\n   542\t        _vorm(uitvoer[\"uncertainty\"] != \"decisive\" and vraag is None)\n   543\t    elif verdict == \"fail\":\n   544\t        _vorm(bool(functies & GEBREK))\n   545\t        _vorm(vraag is None or _een_vraag(vraag))\n   546\t    elif verdict == \"insufficient_information\":\n   547\t        _vorm(not functies & GEBREK and _een_vraag(vraag))\n   548\t        _vorm(uitvoer[\"uncertainty\"] == \"decisive\")\n   549\t    else:\n   550\t        _vorm(_gevuld(scope) and not uitvoer[\"passages\"] and vraag is None)\n   551\t        _vorm(uitvoer[\"coverage\"] == \"none\" and uitvoer[\"uncertainty\"] == \"none\")\n   552\t\n   553\t\n   554\t# --- Meldingen -----------------------------------------------------------------\n   555\t\n   556\t\n   557\tdef _zonder_slotpunt(tekst: str) -> str:\n   558\t    tekst = tekst.rstrip()\n   559\t    return tekst[:-1] if tekst.endswith(\".\") else tekst\n   560\t\n   561\t\n   562\tdef _grondtekst(grond: dict[str, Any]) -> str:\n   563\t    if grond[\"field\"] == \"bron\":\n   564\t        label = f\"bronpassage {grond['ref']}\"\n   565\t    else:\n   566\t        label = _GRONDLABEL[grond[\"field\"]]\n   567\t    if grond[\"quote\"] is not None:\n   568\t        label += f\" ('{grond['quote']}')\"\n   569\t    return label\n   570\t\n   571\t\n   572\tdef _eerste(passages: list[dict[str, Any]], functies: frozenset[str]) -> dict:\n   573\t    return min(\n   574\t        (p for p in passages if p[\"function\"] in functies),\n   575\t        key=lambda p: (p[\"start\"], p[\"end\"]),\n   576\t    )\n   577\t\n   578\t\n   579\tdef _vul(sjabloon: str, waarden: dict[str, str]) -> str:\n   580\t    \"\"\"Vul de plaatshouders van het sjabloon in één doorgang.\n   581\t\n   582\t    Alleen het oorspronkelijke sjabloon wordt gescand; ingevoegde waarden\n   583\t    (citaat, grond, reden, vraag) worden nooit opnieuw geïnterpreteerd, ook\n   584\t    niet als zij zelf '{grond}' of '{één vraag}' bevatten (review WP1 P2-2).\n   585\t    \"\"\"\n   586\t    patroon = re.compile(\"|\".join(re.escape(sleutel) for sleutel in waarden))\n   587\t    return patroon.sub(lambda treffer: waarden[treffer.group(0)], sjabloon)\n   588\t\n   589\t\n   590\tdef _status_en_melding(uitvoer: dict[str, Any]) -> tuple[str, str | None, str]:\n   591\t    verdict = uitvoer[\"verdict\"]\n   592\t    if verdict == \"pass\":\n   593\t        p = _eerste(uitvoer[\"passages\"], BESCHRIJVEND)\n   594\t        melding = _vul(\n   595\t            MELDING_V,\n   596\t            {\n   597\t                \"{passage}\": p[\"quote\"],\n   598\t                \"{criterium/afleiding/kenmerk}\": _FUNCTIELABEL[p[\"function\"]],\n   599\t                \"{grond}\": _grondtekst(p[\"ground\"]),\n   600\t            },\n   601\t        )\n   602\t        return \"pass\", None, melding\n   603\t    if verdict == \"fail\":\n   604\t        p = _eerste(uitvoer[\"passages\"], GEBREK)\n   605\t        discretie = p[\"function\"] == \"discretionary_decision_rule\"\n   606\t        melding = _vul(\n   607\t            MELDING_VN,\n   608\t            {\n   609\t                \"{passage}\": p[\"quote\"],\n   610\t                \"{handeling/afweging}\": (\n   611\t                    \"een afweging\" if discretie else \"een handeling\"\n   612\t                ),\n   613\t                \"{grond}\": _grondtekst(p[\"ground\"]),\n   614\t            },\n   615\t        )\n   616\t        if discretie:\n   617\t            melding += \" \" + _vul(MELDING_VN_DISCRETIE, {\"{citaat}\": p[\"quote\"]})\n   618\t        return \"fail\", None, melding\n   619\t    if verdict == \"insufficient_information\":\n   620\t        melding = _vul(\n   621\t            MELDING_O,\n   622\t            {\n   623\t                \"{ontbrekende of strijdige betekenisgrond}\": _zonder_slotpunt(\n   624\t                    uitvoer[\"reason\"]\n   625\t                ),\n   626\t                \"{één vraag}\": uitvoer[\"question\"],\n   627\t            },\n   628\t        )\n   629\t        return \"review_required\", \"insufficient_information\", melding\n   630\t    melding = _vul(\n   631\t        MELDING_NVT, {\"{reikwijdtegrond}\": _zonder_slotpunt(uitvoer[\"scope_reason\"])}\n   632\t    )\n   633\t    return \"not_applicable\", None, melding\n   634\t\n   635\t\n   636\t# --- Document en replay ---------------------------------------------------------\n   637\t\n   638\t\n   639\t@dataclass(frozen=True)\n   640\tclass Beoordelingsdocument:\n   641\t    \"\"\"Onveranderlijk document: exacte invoer, binding, uitvoering en oordeel.\n   642\t\n   643\t    `oordeel_json` is de canonieke JSON van de geaccepteerde uitvoer, of None\n   644\t    als er geen geldig oordeel is. `toets_actualiteit` accepteert een document\n   645\t    alleen als het opnieuw exact uit zijn eigen invoer, binding, uitvoering\n   646\t    en oordeel volgt; een direct samengesteld of gemanipuleerd document is dus\n   647\t    nooit stil een actueel oordeel.\n   648\t    \"\"\"\n   760\t    _eis(isinstance(waarde, soort), f\"{soort.__name__} verwacht\")\n   761\t    return soort(**{f.name: getattr(waarde, f.name) for f in fields(soort)})\n   762\t\n   763\t\n   764\tdef _herleidbaar(document: Beoordelingsdocument) -> bool:\n   765\t    \"\"\"Volgt het document exact uit zijn eigen invoer, binding en oordeel?\n   766\t\n   767\t    Vangt directe constructie en manipulatie (bijvoorbeeld via\n   768\t    `object.__setattr__`): alleen een document dat `beoordeel` opnieuw\n   769\t    identiek oplevert, kan een actueel oordeel dragen.\n   770\t    \"\"\"\n   771\t    try:\n   772\t        invoer = _hervalideer(document.invoer, Int02Invoer)\n   773\t        for bron in invoer.bronnen:\n   774\t            _hervalideer(bron, Bronpassage)\n   775\t        binding = _hervalideer(document.binding, Binding)\n   776\t        uitvoering = _hervalideer(document.uitvoering, Uitvoering)\n   777\t        _eis(\n   778\t            document.oordeel_json is None or isinstance(document.oordeel_json, str),\n   779\t            \"oordeel_json is tekst of None\",\n   780\t        )\n   781\t    except Int02ContractError:\n   782\t        return False\n   783\t    try:\n   784\t        oordeel = document.oordeel\n   785\t    except (ValueError, RecursionError):\n   786\t        # Niet te decoderen: ongeldige JSON (JSONDecodeError), een getal boven\n   787\t        # de cijferlimiet van int of te diepe nesting (review WP1 P2-3).\n   788\t        return False\n   789\t    try:\n   790\t        opnieuw = beoordeel(invoer, binding.configuratie(), oordeel, uitvoering)\n   791\t    except Int02ContractError:\n   792\t        return False\n   793\t    return opnieuw == document\n   794\t\n   795\t\n   796\tdef toets_actualiteit(\n   797\t    document: Beoordelingsdocument | None,\n   798\t    invoer: Int02Invoer,\n   799\t    configuratie: Configuratie,\n   800\t) -> Actualiteit:\n   801\t    \"\"\"Pas een bewaard document toe op de actuele invoer en configuratie.\n   802\t\n   803\t    Volgorde: actuele kern/context ontbreekt (NE) → geen document (nog te\n   804\t    beoordelen) → technische fout of niet-herleidbaar document (error) →\n   805\t    andere binding (historisch) → het bewaarde oordeel. Het document zelf\n   806\t    wordt nooit gewijzigd.\n   807\t    \"\"\"\n   808\t    actueel = bereken_binding(invoer, configuratie)\n   809\t    ontbreekt = ontbrekende_invoer(invoer)\n   810\t    if ontbreekt:\n   811\t        melding = MELDING_NE.replace(\"{kern/context}\", ontbreekt)\n   812\t        return Actualiteit(\"not_evaluated\", None, melding)\n   813\t    if document is None:\n   814\t        return Actualiteit(\"review_required\", \"not_assessed\", MELDING_NIET_BEOORDEELD)\n   815\t    if (\n   816\t        not isinstance(document, Beoordelingsdocument)\n   817\t        or document.status == \"error\"\n   818\t        or not _herleidbaar(document)\n   819\t    ):\n   820\t        return Actualiteit(\"error\", None, MELDING_E)\n   821\t    if document.binding != actueel:\n   822\t        return Actualiteit(\"review_required\", \"historical\", MELDING_HISTORISCH)\n   823\t    return Actualiteit(document.status, document.reden, document.melding)\n","exit_code":0,"status":"completed"}}
