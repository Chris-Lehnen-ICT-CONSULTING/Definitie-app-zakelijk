+    houder = subprocess.Popen(  # vaste interpreter, vast script
+        [sys.executable, "-c", _SLOTHOUDER, str(k.proefmap / m.SLOT_NAAM)],
+        stdin=subprocess.PIPE,
+        stdout=subprocess.PIPE,
+        text=True,
+        env=omgeving,
