import copy, importlib.util, json, sys
U = sys.argv[1]
spec = importlib.util.spec_from_file_location("replay_v3", f"{U}/vervolg-keten-replay-v3.py")
v3 = importlib.util.module_from_spec(spec)
spec.loader.exec_module(v3)
basis = json.load(open(f"{U}/vervolg-keten-replay-v3.json", encoding="utf-8"))
basis.pop("exitstatus")
print("basis (ongewijzigd):", v3.eindstatus(basis))
gevallen = {
    "route B niet uitgevoerd (C83)": ("C83", lambda b: b.update(uitgevoerd=False)),
    "teruggelezen registratie ontbreekt (C105)": ("C105", lambda b: b.update(registratie_teruggelezen=None)),
    "verkeerde teruggelezen NE-melding (C56)": ("C56", lambda b: b["registratie_teruggelezen"].update(
        deel="INT-02 — Niet uitgevoerd: kern ontbreekt. Er is geen inhoudelijk oordeel.")),
}
afgewezen = 0
for naam, (casus, injecteer) in gevallen.items():
    uit = copy.deepcopy(basis)
    injecteer(uit[casus]["route_b"])
    fouten = v3.route_b_fouten(casus, uit[casus]["route_b"])
    status = v3.eindstatus(uit)
    print(f"{naam}: eindstatus={status} fouten={fouten}")
    afgewezen += status == 1 and bool(fouten)
print(f"afgewezen: {afgewezen}/3")
sys.exit(0 if afgewezen == 3 and v3.eindstatus(basis) == 0 else 1)

