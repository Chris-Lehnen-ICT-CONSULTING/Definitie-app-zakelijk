ldoet\", \"compactheid\": \"voldoet\", \"begrijpelijkheid\": \"tekort\", \"bronsteun\": \"voldoet\", \"betekenisbehoud\": \"tekort\"},\n      \"opgeschoond\": {\"zinsstructuur\": \"voldoet\", \"compactheid\": \"voldoet\", \"begrijpelijkheid\": \"tekort\", \"bronsteun\": \"voldoet\", \"betekenisbehoud\": \"tekort\"},\n      \"bevindingen\": [\n        {\"as\": \"begrijpelijkheid\", \"passage\": \"verminderd met de uit beginstand, geregistreerde uitgiften en geregistreerde terugkomsten berekende verwachte hoeveelheid\", \"bron\": \"G05-B01; doelgroep vrijwilligers zonder administratieve vakopleiding\", \"oordeel\": \"De lange bepaling tussen aftrekbewerking en verwacht aantal maakt de kernberekening onvoldoende toegankelijk. De aansluitende tekenuitleg biedt hulp, maar lost deze stapeling niet op.\"},\n        {\"as\": \"betekenisbehoud\", \"passage\": \"Uitkomst in exemplaren\", \"bron\": \"G05-B01; beschermd: op zichzelf geen bewijs van verlies\", \"oordeel\": \"De beschermde beperking van de bewijskracht ontbreekt en volgt niet uit de formule of eenheid. Zij is niet tegengesproken, maar niet behouden.\"},\n        {\"as\": \"bronsteun,betekenisbehoud\", \"passage\": \"een negatieve uitkomst minder en nul overeenstemming\", \"bron\": \"G05-B01; beschermde rekenkenmerken\", \"oordeel\": \"De uitleg van het teken is correct; ook aftrekrichting, berekeningsbasis, vergelijkbaarheid en eenheid blijven behouden.\"}\n      ],\n      \"opschoning_effect\": \"Alleen een eindpunt toegevoegd; geen inhoudelijke of structurele wijziging.\"\n    },\n    {\n      \"id\": \"B18\",\n      \"beoordeling_geldt_voor\": [\"ruw\", \"opgeschoond\"],\n      \"ruw\": {\"zinsstructuur\": \"voldoet\", \"compactheid\": \"voldoet\", \"begrijpelijkheid\": \"voldoet\", \"bronsteun\": \"voldoet\", \"betekenisbehoud\": \"tekort\"},\n      \"opgeschoond\": {\"zinsstructuur\": \"voldoet\", \"compactheid\": \"voldoet\", \"begrijpelijkheid\": \"voldoet\", \"bronsteun\": \"voldoet\", \"betekenisbehoud\": \"tekort\"},\n      \"bevindingen\": [\n        {\"as\": \"betekenisbehoud\", \"passage\": \"ingesteld bij een concrete aanwijzing\", \"bron\": \"G06-B01; beschermd: koppeling wordt nog onderzocht\", \"oordeel\": \"De concrete aanwijzing is behouden, maar een lopend onderzoek staat niet als aanvullende voorwaarde in de definitie. Bevestiging of herstel als eindpunt impliceert dat onderzoek niet noodzakelijk.\"},\n        {\"as\": \"betekenisbehoud\", \"passage\": \"waarbij de bijlage behouden blijft en de overige dossierstukken zichtbaar blijven\", \"bron\": \"G06-B01; beschermde negaties over inhoud en aanvraaguitkomst\", \"oordeel\": \"Niet-verwijdering en beperkte documentreikwijdte zijn expliciet behouden. De grenzen aan wat de maatregel zegt over inhoudelijke juistheid en aanvraaguitkomst ontbreken, zonder dat het tegendeel wordt beweerd.\"},\n        {\"as\": \"betekenisbehoud\", \"passage\": \"eindigend zodra de koppeling is bevestigd of hersteld\", \"bron\": \"G06-B01; beëindiging zonder ochtendoverleg\", \"oordeel\": \"De directe eindvoorwaarde sluit impliciet wachten op het ochtendoverleg uit.\"}\n      ],\n      \"opschoning_effect\": \"Beginhoofdletter en eindpunt toegevoegd; alle inhoudelijke voorwaarden en omissies blijven gelijk.\"\n    },\n    {\n      \"id\": \"B19\",\n      \"beoordeling_geldt_voor\": [\"ruw\", \"opgeschoond\"],\n      \"ruw\": {\"zinsstructuur\": \"voldoet\", \"compactheid\": \"voldoet\", \"begrijpelijkheid\": \"voldoet\", \"bronsteun\": \"voldoet\", \"betekenisbehoud\": \"voldoet\"},\n      \"opgeschoond\": {\"zinsstructuur\": \"voldoet\", \"compactheid\": \"voldoet\", \"begrijpelijkheid\": \"voldoet\", \"bronsteun\": \"voldoet\", \"betekenisbehoud\": \"voldoet\"},\n      \"bevindingen\": [\n        {\"as\": \"betekenisbehoud\", \"passage\": \"precies drie bij elkaar horende stukken die betrekking hebben op dezelfde uitleenkast en hetzelfde moment van beheerderswisseling\", \"bron\": \"G04-B01; gesloten samenstelling en gezamenlijke betrekking\", \"oordeel\": \"De drie onderdelen en hun gemeenschappelijke kast en overdrachtsmoment zijn ondubbelzinnig behouden.\"},\n        {\"as\": \"betekenisbehoud\", \"passage\": \"een door de vertrekkende beheerder ingevuld afwijkingenblad\", \"bron\": \"G04-B01; verplicht blad zonder afwijkingen en overige uitsluitingen\", \"oordeel\": \"Dit onderdeel is onvoorwaardelijk vereist en kan dus niet vervallen bij afwezigheid van afwijkingen. Precies drie stukken met de volledige opsomming sluit andere documenten, map en toelichting als onderdelen uit; de drager is expliciet vrij.\"}\n      ],\n      \"opschoning_effect\": \"Alleen een eindpunt toegevoegd; gesloten samenstelling en betekenis blijven intact.\"\n    },\n    {\n      \"id\": \"B20\",\n      \"beoordeling_geldt_voor\": [\"ruw\", \"opgeschoond\"],\n      \"ruw\": {\"zinsstructuur\": \"voldoet\", \"compactheid\": \"voldoet\", \"begrijpelijkheid\": \"voldoet\", \"bronsteun\": \"tekort\", \"betekenisbehoud\": \"tekort\"},\n      \"opgeschoond\": {\"zinsstructuur\": \"voldoet\", \"compactheid\": \"voldoet\", \"begrijpelijkheid\": \"voldoet\", \"bronsteun\": \"tekort\", \"betekenisbehoud\": \"tekort\"},\n      \"bevindingen\": [\n        {\"as\": \"bronsteun,betekenisbehoud\", \"passage\": \"wordt voortgezet\", \"bron\": \"G02-B01; mogelijkheid tot hervatting\", \"oordeel\": \"De bron ondersteunt dat behandeling na ontvangst kan doorgaan. De tekst maakt feitelijke voortzetting tot gevolg en geeft daarmee een sterkere toezegging.\"},\n        {\"as\": \"betekenisbehoud\", \"passage\": \"stilligt uitsluitend doordat één gevraagde plattegrond ontbreekt\", \"bron\": \"G02-B01; beschermde aanleiding en uitsluitingen\", \"oordeel\": \"De exclusieve oorzaak is scherp geformuleerd. Samen met aanwezige en gecontroleerde overige gegevens sluit dit andere ontbrekende gegevens en een capaciteitsbesluit als zelfstandige wachtreden uit; wachttijd wordt geen criterium.\"}\n      ],\n      \"opschoning_effect\": \"A