{"type":"item.completed","item":{"id":"item_2","type":"agent_message","text":"{\n  \"rol\": \"beoordelaar\",\n  \"model\": \"gpt-6-astra\",\n  \"reasoning\": \"high\",\n  \"ai_beoordeeld\": true,\n  \"teksten\": [\n    {\n      \"id\": \"B01\",\n      \"beoordeling_geldt_voor\": [\"ruw\", \"opgeschoond\"],\n      \"ruw\": {\"zinsstructuur\": \"voldoet\", \"compactheid\": \"voldoet\", \"begrijpelijkheid\": \"voldoet\", \"bronsteun\": \"tekort\", \"betekenisbehoud\": \"tekort\"},\n      \"opgeschoond\": {\"zinsstructuur\": \"voldoet\", \"compactheid\": \"voldoet\", \"begrijpelijkheid\": \"voldoet\", \"bronsteun\": \"tekort\", \"betekenisbehoud\": \"tekort\"},\n      \"bevindingen\": [\n        {\"as\": \"bronsteun,betekenisbehoud\", \"passage\": \"wordt voortgezet\", \"bron\": \"G02-B01; mogelijkheid tot hervatting\", \"oordeel\": \"De bron zegt dat dezelfde behandeling kan worden voortgezet. De definitie maakt daarvan daadwerkelijke voortzetting en versterkt daarmee de toezegging.\"},\n        {\"as\": \"zinsstructuur,compactheid,begrijpelijkheid\", \"passage\": \"doordat uitsluitend de gevraagde plattegrond ontbreekt terwijl alle overige vereiste gegevens aanwezig en gecontroleerd zijn\", \"bron\": \"G02-B01; oorzaak en volledigheid\", \"oordeel\": \"De samenhangende bijzinnen behouden noodzakelijke voorwaarden binnen één begrijpelijke definitiekern; hun lengte is functioneel.\"}\n      ],\n      \"opschoning_effect\": \"Alleen een eindpunt toegevoegd; geen betekeniswijziging of nieuwe zinsgrens.\"\n    },\n    {\n      \"id\": \"B02\",\n      \"beoordeling_geldt_voor\": [\"ruw\", \"opgeschoond\"],\n      \"ruw\": {\"zinsstructuur\": \"voldoet\", \"compactheid\": \"voldoet\", \"begrijpelijkheid\": \"tekort\", \"bronsteun\": \"voldoet\", \"betekenisbehoud\": \"tekort\"},\n      \"opgeschoond\": {\"zinsstructuur\": \"voldoet\", \"compactheid\": \"voldoet\", \"begrijpelijkheid\": \"tekort\", \"bronsteun\": \"voldoet\", \"betekenisbehoud\": \"tekort\"},\n      \"bevindingen\": [\n        {\"as\": \"begrijpelijkheid\", \"passage\": \"verminderd met het voor diezelfde materiaalsoort en datzelfde afsluitmoment uit beginstand, geregistreerde uitgiften en geregistreerde terugkomsten berekende verwachte aantal\", \"bron\": \"G05-B01; doelgroep vrijwilligers zonder administratieve vakopleiding\", \"oordeel\": \"Tussen de aftrekbewerking en het af te trekken aantal staat een lange stapeling bepalingen. Daardoor is de berekening voor deze doelgroep onvoldoende direct te volgen.\"},\n        {\"as\": \"betekenisbehoud\", \"passage\": \"Uitkomst in aantal exemplaren\", \"bron\": \"G05-B01; beschermd: op zichzelf geen bewijs van verlies\", \"oordeel\": \"De beperking van de bewijskracht wordt niet vermeld en volgt niet logisch uit de eenheid. Zij wordt niet tegengesproken, maar als beschermde interpretatiebeperking niet behouden.\"},\n        {\"as\": \"betekenisbehoud,bronsteun\", \"passage\": \"verminderd met\", \"bron\": \"G05-B01; aftrekrichting en tekenbetekenis\", \"oordeel\": \"Aftrekrichting, berekeningsbasis en vergelijkbaarheid blijven behouden. Positief betekent hierdoor impliciet meer geteld en negatief minder; exemplaren sluit geld als eenheid uit.\"}\n      ],\n      \"opschoning_effect\": \"Alleen een eindpunt toegevoegd; de moeilijke formulering en ontbrekende interpretatiebeperking blijven bestaan.\"\n    },\n    {\n      \"id\": \"B03\",\n      \"beoordeling_geldt_voor\": [\"ruw\", \"opgeschoond\"],\n      \"ruw\": {\"zinsstructuur\": \"voldoet\", \"compactheid\": \"voldoet\", \"begrijpelijkheid\": \"voldoet\", \"bronsteun\": \"voldoet\", \"betekenisbehoud\": \"voldoet\"},\n      \"opgeschoond\": {\"zinsstructuur\": \"voldoet\", \"compactheid\": \"voldoet\", \"begrijpelijkheid\": \"voldoet\", \"bronsteun\": \"voldoet\", \"betekenisbehoud\": \"voldoet\"},\n      \"bevindingen\": [\n        {\"as\": \"betekenisbehoud,bronsteun\", \"passage\": \"voor één interne verplaatsing van een herbruikbare bak\", \"bron\": \"G01-B01; beschermde routekenmerken en negaties\", \"oordeel\": \"De ene verplaatsing, routegegevens, afsluiting en uitsluiting van inhoud en voorraadwaarde blijven behouden. Tussenplekken worden niet uitdrukkelijk verplicht; een lege reeks blijft mogelijk. De omschrijving als document stelt geen papier-, formaat- of kleurvoorwaarde.\"}\n      ],\n      \"opschoning_effect\": \"Alleen een eindpunt toegevoegd; beide versies bevatten dezelfde ene definitiekern.\"\n    },\n    {\n      \"id\": \"B04\",\n      \"beoordeling_geldt_voor\": [\"ruw\", \"opgeschoond\"],\n      \"ruw\": {\"zinsstructuur\": \"voldoet\", \"compactheid\": \"voldoet\", \"begrijpelijkheid\": \"voldoet\", \"bronsteun\": \"voldoet\", \"betekenisbehoud\": \"voldoet\"},\n      \"opgeschoond\": {\"zinsstructuur\": \"voldoet\", \"compactheid\": \"voldoet\", \"begrijpelijkheid\": \"voldoet\", \"bronsteun\": \"voldoet\", \"betekenisbehoud\": \"voldoet\"},\n      \"bevindingen\": [\n        {\"as\": \"betekenisbehoud\", \"passage\": \"de Kamer voor Toegang en Verblijf en het Bureau voor Routes en Rust dezelfde tekst hebben vastgesteld\", \"bron\": \"G03-B01; beschermde namen en gezamenlijke vaststelling\", \"oordeel\": \"Beide namen zijn intact en vaststelling van dezelfde tekst door beide organen sluit een afzonderlijk advies impliciet uit. Het ontbreken van een ingebruiknamebesluit is expliciet behouden.\"},\n        {\"as\": \"compactheid,bronsteun\", \"passage\": \"met aandachtspunten voor bereikbaarheid en rustplekken\", \"bron\": \"G03-B01\", \"oordeel\": \"Deze korte, ondersteunde inhoudsaanduiding is niet noodzakelijk voor de beschermde afbakening, maar maakt de tekst niet onnodig uitvoerig.\"}\n      ],\n      \"opschoning_effect\": \"Alleen een eindpunt toegevoegd; namen, nevenschikking en betekenis blijven gelijk.\"\n    },\n    {\n      \"id\": \"B05\",\n      \"beoordeling_geldt_voor\": [\"ruw\", \"opgeschoond\"],\n      \"ruw\": {\"zinsstructuur\": \"voldoet\", \"compactheid\": \"tekort\", \"begrijpelijkheid\": \"tekort\", \"bronsteun\": \"voldoet\", \"betekenisbehoud\": \"onzeker\"},\n      \"opgeschoond\": {\"zinsstructuur\": \"voldoet\", \"compactheid\": \"tekort\", \"begrijpelijkheid\": \"tekort\", \"bronsteun\": \"voldoet\", \"betekenisbehoud\": \"onzeker\"},\n      \"bevindingen\": [\n        {\"as\": \"begrijpelijkheid,betekenisbehoud\", \"passage\": \"die bij één wisseling van kastbeheerder van dezelfde uitleenkast en hetzelfde overdrachtsmoment samenhangen\", \"bron\": \"G04-B01; alle onderdelen betreffen dezelfde kast en hetzelfde overdrachtsmoment\", \"oordeel\": \"De grammaticale aansluiting van kast, overdrachtsmoment en samenhangen is gebrekkig. De bedoelde gemeenschappelijke betrekking is herkenbaar, maar niet ondubbelzinnig geformuleerd.\"},\n        {\"as\": \"compactheid\", \"passage\": \"ook bij het ontbreken van afwijkingen die uitkomst vermeldt, ongeacht de drager waarop de stukken worden overgedragen\", \"bron\": \"G04-B01; verplicht afwijkingenblad en drageronafhankelijkheid\", \"oordeel\": \"De omslachtige verwijzingen naar ontbreken, die uitkomst en de drager waarop stapelen formuleringen die zonder verlies directer kunnen. Het tekort berust op deze omhaal, niet op het opnemen van de beschermde voorwaarden.\"},\n        {\"as\": \"betekenisbehoud,bronsteun\", \"passage\": \"precies drie stukken\", \"bron\": \"G04-B01; gesloten samenstelling\", \"oordeel\": \"De drie juiste onderdelen en het verplichte ingevulde afwijkingenblad zijn behouden. De gesloten opsomming sluit aanvullende documenten en verpakkingen als onderdeel uit.\"}\n      ],\n      \"opschoning_effect\": \"Alleen een eindpunt toegevoegd; de onduidelijke syntactische aansluiting wordt niet hersteld.\"\n    },\n    {\n      \"id\": \"B06\",\n      \"beoordeling_geldt_voor\": [\"ruw\", \"opgeschoond\"],\n      \"ruw\": {\"zinsstructuur\": \"voldoet\", \"compactheid\": \"voldoet\", \"begrijpelijkheid\": \"voldoet\", \"bronsteun\": \"voldoet\", \"betekenisbehoud\": \"voldoet\"},\n      \"opgeschoond\": {\"zinsstructuur\": \"voldoet\", \"compactheid\": \"voldoet\", \"begrijpelijkheid\": \"voldoet\", \"bronsteun\": \"voldoet\", \"betekenisbehoud\": \"voldoet\"},\n      \"bevindingen\": [\n        {\"as\": \"betekenisbehoud,bronsteun\", \"passage\": \"de vertrekplek, de bestemmingsplek en de geplande volgorde van tussenplekken\", \"bron\": \"G01-B01; beschermde routekenmerken en negaties\", \"oordeel\": \"Alle vereiste routegegevens, de ene interne bakverplaatsing en afsluiting bij aankomst zijn behouden. Tussenplekken hoeven niet aanwezig te zijn; inhoud en voorraadwaarde zijn uitgesloten en papierkenmerken worden niet als voorwaarden ingevoerd.\"}\n      ],\n      \"opschoning_effect\": \"Alleen een eindpunt toegevoegd; geen structurele of inhoudelijke wijziging.\"\n    },\n    {\n      \"id\": \"B07\",\n      \"beoordeling_geldt_voor\": [\"ruw\", \"opgeschoond\"],\n      \"ruw\": {\"zinsstructuur\": \"voldoet\", \"compactheid\": \"voldoet\", \"begrijpelijkheid\": \"onzeker\", \"bronsteun\": \"voldoet\", \"betekenisbehoud\": \"tekort\"},\n      \"opgeschoond\": {\"zinsstructuur\": \"voldoet\", \"compactheid\": \"voldoet\", \"begrijpelijkheid\": \"onzeker\", \"bronsteun\": \"voldoet\", \"betekenisbehoud\": \"tekort\"},\n      \"bevindingen\": [\n        {\"as\": \"begrijpelijkheid\", \"passage\": \"aan het verkeerde dossier is gekoppeld, die voortduurt\", \"bron\": \"G06-B01; beëindiging van de maatregel\", \"oordeel\": \"Die moet terugverwijzen naar maatregel, maar staat direct na een bijzin over de bijlage. Die afstand maakt de verwijzing voor de doelgroep onnodig onzeker.\"},\n        {\"as\": \"betekenisbehoud\", \"passage\": \"ingesteld bij een concrete aanwijzing\", \"bron\": \"G06-B01; beschermd: koppeling wordt nog onderzocht\", \"oordeel\": \"De aanwijzing is behouden, maar een lopend onderzoek wordt niet vermeld. Een aanwijzing en wachten op bevestiging of herstel impliceren niet noodzakelijk dat daadwerkelijk onderzoek gaande is.\"},\n        {\"as\": \"betekenisbehoud\", \"passage\": \"waarbij de bijlage behouden blijft en de overige dossierstukken zichtbaar blijven\", \"bron\": \"G06-B01; beschermde negaties over inhoud en aanvraaguitkomst\", \"oordeel\": \"Niet-verwijdering en zichtbaarheid van andere stukken zijn behouden. De beperkingen dat de maatregel niets zegt over inhoudelijke juistheid en aanvraaguitkomst ontbreken; er staat geen tegengestelde uitspraak, maar die beschermde interpretatiegrenzen zijn niet vastgelegd.\"}\n      ],\n      \"opschoning_effect\": \"Beginhoofdletter en eindpunt toegevoegd; verwijzingsonzekerheid en inhoudelijke omissies blijven bestaan.\"\n    },\n    {\n      \"id\": \"B08\",\n      \"beoordeling_geldt_voor\": [\"ruw\", \"opgeschoond\"],\n      \"ruw\": {\"zinsstructuur\": \"voldoet\", \"compactheid\": \"voldoet\", \"begrijpelijkheid\": \"voldoet\", \"bronsteun\": \"voldoet\", \"betekenisbehoud\": \"voldoet\"},\n      \"opgeschoond\": {\"zinsstructuur\": \"voldoet\", \"compactheid\": \"voldoet\", \"begrijpelijkheid\": \"voldoet\", \"bronsteun\": \"voldoet\", \"betekenisbehoud\": \"voldoet\"},\n      \"bevindingen\": [\n        {\"as\": \"betekenisbehoud\", \"passage\": \"uitsluitend bestaat uit\", \"bron\": \"G04-B01; precies drie onderdelen en beschermde uitsluitingen\", \"oordeel\": \"De gesloten opsomming bevat precies de drie vereiste onderdelen. Het ingevulde afwijkingenblad is onvoorwaardelijk onderdeel en blijft daardoor impliciet verplicht zonder afwijkingen; andere documenten, map en toelichting vallen buiten de samenstelling.\"},\n        {\"as\": \"betekenisbehoud\", \"passage\": \"bij één wisseling van kastbeheerder van één uitleenkast\", \"bron\": \"G04-B01; dezelfde kast en hetzelfde overdrachtsmoment\", \"oordeel\": \"Deze gemeenschappelijke inleiding omvat de hele verzameling. Samen met die kast en dat overdrachtsmoment behoudt zij de gedeelde betrekking, zonder die voor ieder stuk te herhalen.\"}\n      ],\n      \"opschoning_effect\": \"Alleen een eindpunt toegevoegd; de limitatieve opsomming en haar reikwijdte blijven gelijk.\"\n    },\n    {\n      \"id\": \"B09\",\n      \"beoordeling_geldt_voor\": [\"ruw\", \"opgeschoond\"],\n      \"ruw\": {\"zinsstructuur\": \"voldoet\", \"compactheid\": \"voldoet\", \"begrijpelijkheid\": \"voldoet\", \"bronsteun\": \"voldoet\", \"betekenisbehoud\": \"tekort\"},\n      \"opgeschoond\": {\"zinsstructuur\": \"voldoet\", \"compactheid\": \"voldoet\", \"begrijpelijkheid\": \"voldoet\", \"bronsteun\": \"voldoet\", \"betekenisbehoud\": \"tekort\"},\n      \"bevindingen\": [\n        {\"as\": \"betekenisbehoud\", \"passage\": \"ingesteld bij een concrete aanwijzing\", \"bron\": \"G06-B01; beschermd: koppeling wordt nog onderzocht\", \"oordeel\": \"De concrete aanleiding is behouden, maar de aanvullende voorwaarde van een lopend onderzoek ontbreekt en volgt niet noodzakelijk uit de genoemde eindvoorwaarde.\"},\n        {\"as\": \"betekenisbehoud\", \"passage\": \"waarbij de bijlage behouden blijft en de overige dossierstukken zichtbaar blijven\", \"bron\": \"G06-B01; beschermde negaties over inhoud en aanvraaguitkomst\", \"oordeel\": \"Behoud van het document en zichtbaarheid van de overige stukken zijn expliciet. Dat de maatregel geen oordeel over inhoud of aanvraaguitkomst inhoudt, is niet vermeld en niet logisch gegarandeerd door alleen de beschreven toegangsgevolgen.\"},\n        {\"as\": \"betekenisbehoud\", \"passage\": \"eindigend zodra die koppeling is bevestigd of hersteld\", \"bron\": \"G06-B01; beëindiging zonder ochtendoverleg\", \"oordeel\": \"De directe beëindigingsvoorwaarde behoudt impliciet dat niet op het ochtendoverleg hoeft te worden gewacht.\"}\n      ],\n      \"opschoning_effect\": \"Alleen een eindpunt toegevoegd; geen inhoudelijke of structurele wijziging.\"\n    },\n    {\n      \"id\": \"B10\",\n      \"beoordeling_geldt_voor\": [\"ruw\", \"opgeschoond\"],\n      \"ruw\": {\"zinsstructuur\": \"voldoet\", \"compactheid\": \"voldoet\", \"begrijpelijkheid\": \"voldoet\", \"bronsteun\": \"voldoet\", \"betekenisbehoud\": \"tekort\"},\n      \"opgeschoond\": {\"zinsstructuur\": \"voldoet\", \"compactheid\": \"voldoet\", \"begrijpelijkheid\": \"voldoet\", \"bronsteun\": \"voldoet\", \"betekenisbehoud\": \"tekort\"},\n      \"bevindingen\": [\n        {\"as\": \"betekenisbehoud\", \"passage\": \"ingesteld bij een concrete aanwijzing\", \"bron\": \"G06-B01; beschermd: koppeling wordt nog onderzocht\", \"oordeel\": \"De concrete aanwijzing is behouden, maar daadwerkelijk lopend onderzoek is geen geformuleerde voorwaarde. De eindvoorwaarde alleen waarborgt die niet.\"},\n        {\"as\": \"betekenisbehoud\", \"passage\": \"de bijlage behouden blijft en de overige dossierstukken zichtbaar blijven\", \"bron\": \"G06-B01; beschermde negaties over inhoud en aanvraaguitkomst\", \"oordeel\": \"Deze twee uitsluitingen zijn behouden. De uitsluitingen van een inhoudelijk oordeel en een uitspraak over de aanvraaguitkomst zijn niet vermeld; zij worden ook niet uitdrukkelijk tegengesproken.\"},\n        {\"as\": \"betekenisbehoud\", \"passage\": \"lopend tot de koppeling is bevestigd of hersteld\", \"bron\": \"G06-B01; beëindigingsvoorwaarde\", \"oordeel\": \"Tot geeft het einde bij bevestiging of herstel aan en introduceert geen aanvullende overlegvoorwaarde.\"}\n      ],\n      \"opschoning_effect\": \"Alleen een eindpunt toegevoegd; de ene definitiekern en haar omissies blijven gelijk.\"\n    },\n    {\n      \"id\": \"B11\",\n      \"beoordeling_geldt_voor\": [\"ruw\", \"opgeschoond\"],\n      \"ruw\": {\"zinsstructuur\": \"voldoet\", \"compactheid\": \"voldoet\", \"begrijpelijkheid\": \"voldoet\", \"bronsteun\": \"voldoet\", \"betekenisbehoud\": \"voldoet\"},\n      \"opgeschoond\": {\"zinsstructuur\": \"voldoet\", \"compactheid\": \"voldoet\", \"begrijpelijkheid\": \"voldoet\", \"bronsteun\": \"voldoet\", \"betekenisbehoud\": \"voldoet\"},\n      \"bevindingen\": [\n        {\"as\": \"betekenisbehoud,bronsteun\", \"passage\": \"bij aankomst wordt afgesloten, zonder gegevens over de inhoud of de voorraadwaarde\", \"bron\": \"G01-B01; beschermde kenmerken en negaties\", \"oordeel\": \"De afsluiting en inhoudelijke uitsluiting zijn expliciet, evenals de ene interne verplaatsing en routegegevens. De formulering verplicht niet tot tussenplekken en legt geen voorwaarden aan papier, formaat of kleur op.\"}\n      ],\n      \"opschoning_effect\": \"Alleen een eindpunt toegevoegd; geen betekenis- of structuurwijziging.\"\n    },\n    {\n      \"id\": \"B12\",\n      \"beoordeling_geldt_voor\": [\"ruw\", \"opgeschoond\"],\n      \"ruw\": {\"zinsstructuur\": \"voldoet\", \"compactheid\": \"voldoet\", \"begrijpelijkheid\": \"tekort\", \"bronsteun\": \"voldoet\", \"betekenisbehoud\": \"tekort\"},\n      \"opgeschoond\": {\"zinsstructuur\": \"voldoet\", \"compactheid\": \"voldoet\", \"begrijpelijkheid\": \"tekort\", \"bronsteun\": \"voldoet\", \"betekenisbehoud\": \"tekort\"},\n      \"bevindingen\": [\n        {\"as\": \"begrijpelijkheid\", \"passage\": \"verminderd met de uit beginstand, geregistreerde uitgiften en geregistreerde terugkomsten berekende verwachte hoeveelheid\", \"bron\": \"G05-B01; doelgroep vrijwilligers zonder administratieve vakopleiding\", \"oordeel\": \"De geneste omschrijving van het tweede aantal maakt de aftrekking moeilijk te volgen. De uitleg van positieve en negatieve uitkomsten helpt, maar verhelpt deze dichte rekenomschrijving niet volledig.\"},\n        {\"as\": \"betekenisbehoud\", \"passage\": \"Uitkomst in exemplaren\", \"bron\": \"G05-B01; beschermd: op zichzelf geen bewijs van verlies\", \"oordeel\": \"De beperkte bewijskracht is niet vermeld en wordt niet logisch behouden door alleen de formule of eenheid. Dit is een ontbrekende interpretatiegrens, geen bewering dat verlies bewezen is.\"},\n        {\"as\": \"bronsteun,betekenisbehoud\", \"passage\": \"een positieve uitkomst meer getelde exemplaren dan verwacht aangeeft\", \"bron\": \"G05-B01; beschermde rekenkenmerken\", \"oordeel\": \"Aftrekrichting, berekeningsbasis, vergelijkbaarheid, tekenbetekenis en eenheid zijn correct behouden.\"}\n      ],\n      \"opschoning_effect\": \"Alleen een eindpunt toegevoegd; beoordeling op alle assen blijft gelijk.\"\n    },\n    {\n      \"id\": \"B13\",\n      \"beoordeling_geldt_voor\": [\"ruw\", \"opgeschoond\"],\n      \"ruw\": {\"zinsstructuur\": \"voldoet\", \"compactheid\": \"voldoet\", \"begrijpelijkheid\": \"voldoet\", \"bronsteun\": \"voldoet\", \"betekenisbehoud\": \"voldoet\"},\n      \"opgeschoond\": {\"zinsstructuur\": \"voldoet\", \"compactheid\": \"voldoet\", \"begrijpelijkheid\": \"voldoet\", \"bronsteun\": \"voldoet\", \"betekenisbehoud\": \"voldoet\"},\n      \"bevindingen\": [\n        {\"as\": \"betekenisbehoud,bronsteun\", \"passage\": \"de Kamer voor Toegang en Verblijf en het Bureau voor Routes en Rust dezelfde tekst hebben vastgesteld\", \"bron\": \"G03-B01; beschermde namen en gezamenlijke vaststelling\", \"oordeel\": \"De volledige namen en gezamenlijke vaststelling van dezelfde tekst zijn behouden; vaststelling door slechts één orgaan voldoet hierdoor impliciet niet.\"},\n        {\"as\": \"betekenisbehoud,compactheid\", \"passage\": \"zonder dat daarmee over ingebruikname van die route wordt besloten\", \"bron\": \"G03-B01; advisering vóór het routebesluit\", \"oordeel\": \"De grens met besluitvorming is expliciet. Het niet noemen van bereikbaarheid en rustplekken verliest geen vooraf beschermde differentia voor de gezamenlijke status.\"}\n      ],\n      \"opschoning_effect\": \"Beginhoofdletter en eindpunt toegevoegd; geen wijziging van zinsstructuur of betekenis.\"\n    },\n    {\n      \"id\": \"B14\",\n      \"beoordeling_geldt_voor\": [\"ruw\", \"opgeschoond\"],\n      \"ruw\": {\"zinsstructuur\": \"voldoet\", \"compactheid\": \"voldoet\", \"begrijpelijkheid\": \"voldoet\", \"bronsteun\": \"voldoet\", \"betekenisbehoud\": \"voldoet\"},\n      \"opgeschoond\": {\"zinsstructuur\": \"voldoet\", \"c