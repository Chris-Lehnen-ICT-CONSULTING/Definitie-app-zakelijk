+def _aantal_records(db_pad: Path, begrip: str) -> int:
+    import sqlite3
+
+    with sqlite3.connect(str(db_pad)) as conn:
+        (aantal,) = conn.execute(
+            "SELECT COUNT(*) FROM definities WHERE begrip = ?", (begrip,)
+        ).fetchone()
+    return int(aantal)
